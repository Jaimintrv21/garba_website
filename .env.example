# ── Firebase secrets (never commit this file) ──────────────────
# Copy this to .env and fill in your real values.
# Get from: Firebase Console → Project Settings → Your Apps

FIREBASE_API_KEY=YOUR_API_KEY_HERE
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID_HERE
FIREBASE_APP_ID=YOUR_APP_ID_HERE

# These are non-secret (project identifiers) — pre-filled for navratri-dhamaka
FIREBASE_AUTH_DOMAIN=navratri-dhamaka.firebaseapp.com
FIREBASE_DATABASE_URL=https://navratri-dhamaka-default-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=navratri-dhamaka
FIREBASE_STORAGE_BUCKET=navratri-dhamaka.appspot.com
